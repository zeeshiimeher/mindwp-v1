{
  "name": "mindwp-section-library",
  "version": "0.1.0",
  "private": true,
  "description": "Private MindWP section laboratory. Standalone Next.js application, outside the website build, workspace, routes and deployment.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.1.0",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "capture": "node scripts/capture.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "3.15.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.41",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "globals": "^17.8.0",
    "playwright": "1.60.0",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
